# ===========================================================================
# AgentGuard Environment Configuration
# Copy to .env (which is gitignored) and fill in real values.
# ===========================================================================

# ---------------------------------------------------------------------------
# LLM Provider API Keys
# Only set keys you actually have. Placeholder values are NOT harmless: any
# set key is treated as real, so a fake Cohere/Gemini key makes the reporter
# fail and drop to the deterministic fallback report.
# Free-tier keys:
#   - Groq:    https://console.groq.com     (required: attacker, judge, samples)
#   - Cohere:  https://dashboard.cohere.com
#   - Gemini:  https://aistudio.google.com
# ---------------------------------------------------------------------------
GROQ_API_KEY=
# COHERE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Model Selection (any LiteLLM model string)
# ---------------------------------------------------------------------------
# Attacker: drives the ADK probing loop
AGENTGUARD_ATTACKER_MODEL=groq/openai/gpt-oss-20b
# Chat / judge: independent verification + manifest tool classification
AGENTGUARD_CHAT_MODEL=groq/openai/gpt-oss-20b
# Reporter: CrewAI analyst/engineer/writer (e.g. cohere/command-r-08-2024)
AGENTGUARD_REPORTER_MODEL=groq/openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Execution Tuning (optional; defaults shown in agentguard/config.py)
# ---------------------------------------------------------------------------
# Max probes per attack category (default 8; keep low on free tiers)
AGENTGUARD_MAX_PROBES=3
# Seconds to wait between attack categories (default 15)
AGENTGUARD_CATEGORY_COOLDOWN=15
# HTTP timeout in seconds for requests to the target (default 60)
AGENTGUARD_TARGET_TIMEOUT=60
