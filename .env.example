# AgentGuard settings. Copy to .env (gitignored) and fill in your key. Never commit .env.

# Anthropic key (https://console.anthropic.com). Create it inside a workspace.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=

# Model for AgentGuard's own agents (any LiteLLM model string). Default:
# AGENTGUARD_MODEL=anthropic/claude-sonnet-5-5

# Attack phase: probes per attack type (default 4) and the model the sandboxed project is given.
# AGENTGUARD_MAX_PROBES=4
# Model the app under attack runs on inside the sandbox (default Haiku). Needs that provider's key, e.g. GROQ_API_KEY.
# AGENTGUARD_TARGET_MODEL=groq/openai/gpt-oss-120b

# LangFuse tracing (optional, https://cloud.langfuse.com -> project settings -> API keys)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
