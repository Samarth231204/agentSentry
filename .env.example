# AgentGuard settings. Copy to .env (gitignored) and fill in your key. Never commit .env.

# Anthropic key (https://console.anthropic.com). Create it inside a workspace.
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace:
# ANTHROPIC_WORKSPACE_ID=

# Model for AgentGuard's own agents (any LiteLLM model string). Default:
# AGENTGUARD_MODEL=anthropic/claude-sonnet-5-5
